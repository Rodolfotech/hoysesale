# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (Postgres). En Supabase usa el pooler (puerto 6543) y añade ?pgbouncer=true en Vercel.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/eventos?schema=public

# Sesión: JWT obligatorio (sin valor por defecto)
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
TRUST_PROXY=1

# Tareas programadas (cron de Vercel): openssl rand -hex 32
CRON_SECRET=

# Almacenamiento de imágenes: "local" solo en desarrollo; en producción no definirlo (usa Supabase)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=SupabaseImage_Storage

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Instagram / Meta
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/social/callback
INSTAGRAM_WEBHOOK_TOKEN=

# Correo (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Admin inicial (pnpm seed)
ADMIN_EMAIL=admin@eventos.cl
ADMIN_PASSWORD=

# Frontend
NEXT_PUBLIC_SITE_URL=https://www.hoysesale.cl
